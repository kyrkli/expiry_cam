# Telegram bot settings. Create the real file with:
#   cp bot.env.example bot.env && chmod 600 bot.env
# and never share bot.env: whoever has the token controls the bot.

# Token from @BotFather
TELEGRAM_TOKEN=

# Who may use the bot: comma separated chat IDs.
# Private chat = the person's ID, family group = the group's (negative) ID.
# Unknown users get their ID from the bot when they send /start.
TELEGRAM_ALLOWED_IDS=

# Daily reminder time (Pi's local time) and how many days ahead to look
REMIND_TIME=09:00
REMIND_DAYS=3

# 1 = each product appears in one reminder only, 0 = in every reminder until it expires
REMIND_ONCE=1

# 1 = talk to Telegram over IPv4 only (helps if the home IPv6 is broken and the bot is slow)
TELEGRAM_FORCE_IPV4=0
